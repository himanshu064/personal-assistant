# ---------- Phase 0 ----------

# Database (from Vercel > Storage > Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Encrypts users' AI keys. Exactly 32 characters: openssl rand -hex 16
ENCRYPTION_KEY=

# Email (Resend). Leave empty locally: emails are printed to the server log instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Personal Assistant <no-reply@yourdomain.com>"
# Optional: send every email to this inbox while testing.
RESEND_TO_EMAIL=

# AI defaults (cheapest models). Users can pick others from the allowed lists.
AI_DEFAULT_PROVIDER=google
AI_DEFAULT_MODEL_ANTHROPIC=claude-haiku-5-5
AI_DEFAULT_MODEL_GOOGLE=gemini-2.5-flash-lite
AI_ALLOWED_MODELS_ANTHROPIC=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5
AI_ALLOWED_MODELS_GOOGLE=gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# ---------- Later phases (not needed yet) ----------
# Phase 1: VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT, CRON_SECRET, REMINDER_CRON_INTERVAL_MINUTES=5
# Phase 2: VOYAGE_API_KEY, VOYAGE_MODEL=voyage-4
# Phase 3: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
